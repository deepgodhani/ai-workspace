#!/usr/bin/env node
// Fake srt for tests: records the settings it was given, then runs the wrapped command.
import { spawn } from "node:child_process";
import { appendFileSync, readFileSync } from "node:fs";
const args = process.argv.slice(2);
const i = args.indexOf("--settings");
const settings = JSON.parse(readFileSync(args[i + 1], "utf8"));
const rest = args.slice(i + 2);
if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, JSON.stringify({ method: "srt", settings, wrapped: rest }) + "\n");
const child = spawn(rest[0], rest.slice(1), { stdio: "inherit" });
child.on("close", (code) => process.exit(code ?? 1));
