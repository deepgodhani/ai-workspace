#!/usr/bin/env node
// Fake `kiro-cli acp` for tests: newline-delimited JSON-RPC over stdio.
// FAKE_KIRO_ACTION=write:<path> | exec:<command>   one tool request per prompt
// FAKE_MODE=repair   first reply is not JSON;  FAKE_MODE=sneaky  writes a file without asking
import { appendFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";

const log = (e) => process.env.FAKE_LOG && appendFileSync(process.env.FAKE_LOG, JSON.stringify({ cwd: process.cwd(), args: process.argv.slice(2), ...e }) + "\n");
const send = (m) => process.stdout.write(JSON.stringify(m) + "\n");
let buf = "";
let nextId = 1000;
let prompts = 0;
const waiting = new Map();

function ask(params) {
  return new Promise((res) => {
    const id = nextId++;
    waiting.set(id, res);
    send({ jsonrpc: "2.0", id, method: "session/request_permission", params });
  });
}

async function onPrompt(m) {
  prompts++;
  const sessionId = m.params.sessionId;
  const text = m.params.prompt.map((c) => c.text).join("");
  const action = process.env.FAKE_KIRO_ACTION ?? "";
  let decision = null;
  if (action.startsWith("write:")) {
    const path = resolve(process.cwd(), action.slice(6));
    send({ jsonrpc: "2.0", method: "session/update", params: { sessionId, update: { sessionUpdate: "tool_call", toolCallId: "t1", kind: "edit", title: "Creating file", locations: [{ path }] } } });
    const r = await ask({ sessionId, toolCall: { toolCallId: "t1", title: "Creating file", rawInput: { command: "create", path } }, options: [{ optionId: "allow_once", kind: "allow_once" }, { optionId: "reject_once", kind: "reject_once" }] });
    decision = r.result?.outcome?.optionId ?? "cancelled";
    if (decision === "allow_once") writeFileSync(path, "written by fake kiro\n");
  } else if (action.startsWith("exec:")) {
    const command = action.slice(5);
    send({ jsonrpc: "2.0", method: "session/update", params: { sessionId, update: { sessionUpdate: "tool_call", toolCallId: "t2", kind: "execute", title: `Running: ${command}` } } });
    const r = await ask({ sessionId, toolCall: { toolCallId: "t2", title: `Running: ${command}`, rawInput: { command } }, options: [{ optionId: "allow_once", kind: "allow_once" }, { optionId: "reject_once", kind: "reject_once" }] });
    decision = r.result?.outcome?.optionId ?? "cancelled";
  }
  if (process.env.FAKE_MODE === "sneaky") writeFileSync(resolve(process.cwd(), "SNEAKY.txt"), "x\n");
  log({ method: "session/prompt", text, decision });
  const result = { status: "done", summary: `fake kiro in ${process.cwd()}`, files_changed: [], decisions: [], checks: [], open_issues: [], next_action: "none" };
  const reply = process.env.FAKE_MODE === "repair" && prompts === 1 ? "Sure! Here is my answer in prose." : JSON.stringify(result);
  const half = Math.floor(reply.length / 2);
  for (const part of [reply.slice(0, half), reply.slice(half)]) {
    send({ jsonrpc: "2.0", method: "session/update", params: { sessionId, update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: part } } } });
  }
  send({ jsonrpc: "2.0", method: "_kiro.dev/metadata", params: { sessionId, contextUsagePercentage: 1.5, meteringUsage: [{ value: 0.05, unit: "credit", unitPlural: "credits" }] } });
  send({ jsonrpc: "2.0", id: m.id, result: { stopReason: "end_turn" } });
}

process.stdin.on("data", (d) => {
  buf += d;
  let i;
  while ((i = buf.indexOf("\n")) >= 0) {
    const line = buf.slice(0, i);
    buf = buf.slice(i + 1);
    if (!line.trim()) continue;
    const m = JSON.parse(line);
    if (m.id !== undefined && !m.method && waiting.has(m.id)) {
      waiting.get(m.id)(m);
      waiting.delete(m.id);
      continue;
    }
    if (m.method === "initialize") send({ jsonrpc: "2.0", id: m.id, result: { protocolVersion: 1, agentCapabilities: { loadSession: true } } });
    else if (m.method === "session/new") {
      log({ method: "session/new", params: m.params });
      send({ jsonrpc: "2.0", id: m.id, result: { sessionId: "kiro-sess-1" } });
    } else if (m.method === "session/load") {
      log({ method: "session/load", params: m.params });
      send({ jsonrpc: "2.0", method: "session/update", params: { sessionId: m.params.sessionId, update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: "REPLAYED HISTORY " } } } });
      send({ jsonrpc: "2.0", id: m.id, result: {} });
    } else if (m.method === "session/prompt") onPrompt(m);
  }
});
process.stdin.on("end", () => process.exit(0));
