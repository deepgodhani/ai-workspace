#!/usr/bin/env bash
set -euo pipefail
tool_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$tool_root"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$tool_root/work/uv-cache}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$tool_root/work/uv-python}"
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$tool_root/work/ms-playwright}"
export LOCAL_RESEARCH_WORK_DIR="${LOCAL_RESEARCH_WORK_DIR:-$tool_root/work}"
export CRAWL4_AI_BASE_DIRECTORY="${CRAWL4_AI_BASE_DIRECTORY:-$tool_root/work}"
if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi
export SEARXNG_URL="${SEARXNG_URL:-http://127.0.0.1:${SEARXNG_PORT:-8888}}"

uv run --extra dev pytest

if [[ "${1:-}" == "--integration" ]]; then
  output="$tool_root/tests/output/firestore-enterprise"
  rm -rf "$output"
  uv run --extra crawler local-research \
    "Firestore Enterprise MongoDB compatibility official documentation" \
    --output "$output" \
    --max-results 15 \
    --max-pages 3 \
    --delay 1.0
  test -s "$output/SOURCES.md"
  test -s "$output/COVERAGE.json"
  test -n "$(find "$output/raw" -name '*.md' -type f -print -quit)"
  echo "Integration output: $output"
fi

if [[ "${1:-}" == "--fixture-integration" ]]; then
  output="$tool_root/tests/output/fixture-firestore-enterprise"
  rm -rf "$output"
  uv run python tests/fixture_server.py 18888 &
  fixture_pid=$!
  trap 'kill "$fixture_pid" 2>/dev/null || true' EXIT
  for attempt in {1..20}; do
    if curl --fail --silent http://127.0.0.1:18888/config >/dev/null; then
      break
    fi
    sleep 0.1
  done
  uv run --extra crawler local-research \
    "Firestore Enterprise MongoDB compatibility official documentation" \
    --searxng-url http://127.0.0.1:18888 \
    --output "$output" \
    --max-results 15 \
    --max-pages 2 \
    --retries 0 \
    --delay 0
  test -s "$output/SOURCES.md"
  test -s "$output/COVERAGE.json"
  test -n "$(find "$output/raw" -name '*.md' -type f -print -quit)"
  uv run python -c '
import json
from pathlib import Path
p = Path("tests/output/fixture-firestore-enterprise/COVERAGE.json")
d = json.loads(p.read_text())
assert d["counts"]["discovered"] == 4
assert d["counts"]["canonical_unique"] == 3
assert d["counts"]["processed"] >= 1
assert d["counts"]["failed"] >= 1
assert d["urls"][0]["tier"] == "A"
'
  echo "Fixture integration output: $output"
fi
