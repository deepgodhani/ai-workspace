#!/usr/bin/env bash
set -u
workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

printf 'Workspace: %s\n\n' "$workspace"

check() {
  local cmd="$1"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf 'ok      %-12s %s\n' "$cmd" "$(command -v "$cmd")"
  else
    printf 'missing %-12s\n' "$cmd"
  fi
}

check git
check python3
check node
check npx
check codex
check claude
check gemini
check uv
check docker
check podman

printf '\nStructure:\n'
for dir in _shared agents bin knowledge research projects tools worktrees; do
  if [[ -d "$workspace/$dir" ]]; then
    printf 'ok      %s/\n' "$dir"
  else
    printf 'missing %s/\n' "$dir"
  fi
done

printf '\nReusable agents:\n'
for agent_dir in "$workspace"/agents/*/; do
  [[ -d "$agent_dir" ]] || continue
  name="$(basename "$agent_dir")"
  if [[ -f "$agent_dir/AGENTS.md" ]]; then
    printf 'ok      agents/%s/AGENTS.md\n' "$name"
  else
    printf 'missing agents/%s/AGENTS.md\n' "$name"
  fi
done
if [[ -x "$workspace/bin/new-agent-case" ]]; then
  printf 'ok      bin/new-agent-case\n'
else
  printf 'missing or non-executable bin/new-agent-case\n'
fi
port_registry="$workspace/tools/database-port-registry.yaml"
if [[ -f "$port_registry" ]]; then
  printf 'ok      tools/database-port-registry.yaml\n'
  duplicate_ports="$(
    awk '/^[[:space:]]*-[[:space:]]+port:/ { print $3 }' "$port_registry" |
      sort |
      uniq -d
  )"
  if [[ -n "$duplicate_ports" ]]; then
    printf 'warning duplicate registered database port(s): %s\n' "$duplicate_ports"
  else
    printf 'ok      database port assignments are unique\n'
  fi
else
  printf 'missing tools/database-port-registry.yaml\n'
fi

printf '\nWorkspace lifecycle skills:\n'
for skill in workspace-coach handoff resume-work daily-summary temp-session; do
  canonical="$workspace/_shared/skills/$skill/SKILL.md"
  if [[ -f "$canonical" ]]; then
    printf 'ok      _shared/skills/%s/SKILL.md\n' "$skill"
  else
    printf 'missing _shared/skills/%s/SKILL.md\n' "$skill"
  fi
done
if [[ -x "$workspace/bin/workspace-context" ]]; then
  printf 'ok      bin/workspace-context\n'
else
  printf 'missing or non-executable bin/workspace-context\n'
fi
if [[ -x "$workspace/bin/init-ai-workspace.sh" ]]; then
  printf 'ok      bin/init-ai-workspace.sh\n'
else
  printf 'missing or non-executable bin/init-ai-workspace.sh\n'
fi

printf '\nLocal research:\n'
if [[ -x "$workspace/tools/local-research/bin/status" ]]; then
  "$workspace/tools/local-research/bin/status" || true
else
  printf 'missing tools/local-research/bin/status\n'
fi

for skill_file in \
  "$workspace/_shared/skills/local-web-research/SKILL.md" \
  "$HOME/.agents/skills/local-web-research/SKILL.md" \
  "$HOME/.claude/skills/local-web-research/SKILL.md"; do
  if [[ -f "$skill_file" ]]; then
    printf 'ok      %s\n' "$skill_file"
  else
    printf 'missing %s\n' "$skill_file"
  fi
done

printf '\nMCP status:\n'
printf 'Firecrawl is optional; local-web-research is the default.\n'
if command -v codex >/dev/null 2>&1; then
  codex mcp list 2>/dev/null || printf 'codex: unable to list MCP servers\n'
else
  printf 'codex: not installed\n'
fi
if command -v claude >/dev/null 2>&1; then
  claude mcp list 2>/dev/null || printf 'claude: unable to list MCP servers\n'
else
  printf 'claude: not installed\n'
fi
