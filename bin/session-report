#!/usr/bin/env python3
"""Per-session token report: does context per turn grow with session length?

Reads local AI CLI logs through tokscale (read-only; never submits) and buckets
sessions by message count. Usage: bin/session-report [--since YYYY-MM-DD] [--clients claude]
"""
import argparse, collections, json, math, statistics as st, subprocess, sys

TOKSCALE = "tokscale@4.17.0"
ap = argparse.ArgumentParser()
ap.add_argument("--since", default=None)
ap.add_argument("--clients", default="claude")
a = ap.parse_args()
cmd = ["npx", "-y", TOKSCALE, "models", "--json", "-c", a.clients, "--group-by", "client,session,model"]
cmd += ["--since", a.since] if a.since else ["--month"]
entries = json.loads(subprocess.run(cmd, capture_output=True, text=True, check=True).stdout)["entries"]

S = collections.defaultdict(lambda: [0, 0, 0.0])
for x in entries:
    s = S[x.get("sessionId")]
    s[0] += x.get("messageCount", 0)
    s[1] += x["input"] + x["output"] + x["cacheRead"] + x["cacheWrite"]
    s[2] += x.get("cost", 0)
ss = [v for v in S.values() if v[0] > 0]
if len(ss) < 3:
    sys.exit("not enough sessions in range")
total = sum(v[2] for v in ss) or 1
print(f"{len(ss)} sessions, ${total:,.0f} estimated (API list price)")
print(f"{'msgs/session':>13} {'sessions':>8} {'median tok/msg':>15} {'cost share':>10}")
for lo, hi in [(1, 20), (21, 50), (51, 100), (101, 200), (201, 400), (401, 800), (801, 10**9)]:
    g = [v for v in ss if lo <= v[0] <= hi]
    if g:
        lab = f"{lo}-{hi}" if hi < 10**9 else f"{lo}+"
        print(f"{lab:>13} {len(g):>8} {int(st.median(v[1] / v[0] for v in g)):>15,} {sum(v[2] for v in g) / total * 100:>9.1f}%")
lx = [math.log(v[0]) for v in ss]; ys = [v[1] / v[0] for v in ss]
mx, my = st.mean(lx), st.mean(ys)
den = math.sqrt(sum((p - mx) ** 2 for p in lx) * sum((q - my) ** 2 for q in ys)) or 1
print(f"pearson r(log messages, tokens per message) = {sum((p - mx) * (q - my) for p, q in zip(lx, ys)) / den:.2f}")
