#!/usr/bin/env bash
# Link the workspace's shared skills into each AI CLI's user skill directory.
# Idempotent; never replaces an existing entry that points elsewhere.
set -euo pipefail

workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
src_root="$workspace/_shared/skills"

link_into() {
  local dest_root="$1" label="$2"
  mkdir -p "$dest_root"
  for src in "$src_root"/*/; do
    [[ -f "$src/SKILL.md" ]] || continue
    local name dest
    name="$(basename "$src")"
    dest="$dest_root/$name"
    src="${src%/}"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
      printf 'ok     %s/%s\n' "$label" "$name"
    elif [[ -e "$dest" || -L "$dest" ]]; then
      printf 'skip   %s/%s (exists, points elsewhere)\n' "$label" "$name"
    else
      ln -s "$src" "$dest"
      printf 'link   %s/%s\n' "$label" "$name"
    fi
  done
}

link_into "$HOME/.claude/skills" "~/.claude/skills"   # Claude Code
link_into "$HOME/.agents/skills" "~/.agents/skills"   # Codex and other AGENTS-style CLIs

# Kiro reads workspace-level skills; use relative links so the repo stays portable.
mkdir -p "$workspace/.kiro/skills"
for src in "$src_root"/*/; do
  name="$(basename "$src")"
  dest="$workspace/.kiro/skills/$name"
  [[ -e "$dest" || -L "$dest" ]] || { ln -s "../../_shared/skills/$name" "$dest"; printf 'link   .kiro/skills/%s\n' "$name"; }
done
