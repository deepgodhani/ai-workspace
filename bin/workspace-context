#!/usr/bin/env bash
set -euo pipefail

workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

usage() {
  printf 'Usage: %s <target>\n' "$0" >&2
  printf 'Examples: projects/my-project, my-project, research/topics/mongodb\n' >&2
  exit 2
}

[[ $# -eq 1 ]] || usage
requested="${1%/}"
[[ -n "$requested" ]] || usage

resolve_target() {
  local candidate
  local -a matches=()

  if [[ "$requested" = /* ]]; then
    candidate="$requested"
    [[ -d "$candidate" ]] && matches+=("$candidate")
  elif [[ -d "$workspace/$requested" ]]; then
    matches+=("$workspace/$requested")
  else
    for candidate in \
      "$workspace/projects/$requested" \
      "$workspace/agents/$requested" \
      "$workspace/research/topics/$requested" \
      "$workspace/knowledge/$requested" \
      "$workspace/tools/$requested" \
      "$workspace/temp-sessions/$requested" \
      "$workspace/worktrees/$requested"; do
      [[ -d "$candidate" ]] && matches+=("$candidate")
    done
  fi

  if [[ ${#matches[@]} -eq 0 ]]; then
    printf 'Target not found: %s\n' "$requested" >&2
    exit 1
  fi
  if [[ ${#matches[@]} -gt 1 ]]; then
    printf 'Ambiguous target: %s\n' "$requested" >&2
    printf '  %s\n' "${matches[@]}" >&2
    exit 1
  fi

  (cd "${matches[0]}" && pwd -P)
}

target="$(resolve_target)"
case "$target/" in
  "$workspace/"*) ;;
  *)
    printf 'Target is outside the workspace: %s\n' "$target" >&2
    exit 1
    ;;
esac

relative="${target#"$workspace"/}"
[[ "$target" = "$workspace" ]] && relative="."

case "$relative/" in
  projects/*) type="project" ;;
  agents/*/cases/*) type="agent-case" ;;
  agents/*) type="agent" ;;
  research/topics/*) type="research" ;;
  knowledge/*|knowledge/) type="knowledge" ;;
  tools/*) type="tool" ;;
  _shared/*) type="shared" ;;
  temp-sessions/*) type="temporary" ;;
  worktrees/*) type="worktree" ;;
  ./*) type="workspace" ;;
  *) type="workspace-area" ;;
esac

git_root=""
if git_root="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)"; then
  git_relative="${git_root#"$workspace"/}"
  branch="$(git -C "$git_root" branch --show-current 2>/dev/null || true)"
  changed="$(git -C "$git_root" status --short 2>/dev/null | wc -l | tr -d ' ')"
else
  git_root=""
  git_relative="none"
  branch="none"
  changed="0"
fi

printf 'workspace: %s\n' "$workspace"
printf 'target: %s\n' "$relative"
printf 'type: %s\n' "$type"
printf 'write_scope: %s\n' "$relative"
printf 'git_root: %s\n' "$git_relative"
printf 'git_branch: %s\n' "${branch:-detached}"
printf 'git_changed_paths: %s\n' "$changed"

printf 'instructions:\n'
current="$target"
declare -a instruction_paths=()
while :; do
  [[ -f "$current/AGENTS.md" ]] && instruction_paths+=("$current/AGENTS.md")
  [[ "$current" = "$workspace" ]] && break
  current="$(dirname "$current")"
done
for ((i=${#instruction_paths[@]}-1; i>=0; i--)); do
  printf '  - %s\n' "${instruction_paths[i]#"$workspace"/}"
done

declare -a required=()
add_required() {
  if [[ -f "$1" ]]; then
    required+=("$1")
  fi
  return 0
}

add_required "$target/.ai/STATE.md"
add_required "$target/.ai/TASKS.md"
add_required "$target/.ai/INDEX.md"

if [[ "$type" = "research" ]]; then
  add_required "$target/SCOPE.md"
  add_required "$target/STATE.md"
  add_required "$target/CONTEXT.md"
  add_required "$target/GAPS.md"
elif [[ "$type" = "agent-case" ]]; then
  agent_root="${target%%/cases/*}"
  add_required "$agent_root/.ai/STATE.md"
  add_required "$agent_root/.ai/TASKS.md"
  add_required "$agent_root/.ai/INDEX.md"
  add_required "$target/STATUS.md"
  add_required "$target/verification.yaml"
fi

printf 'required_context:\n'
total_bytes=0
if [[ ${#required[@]} -eq 0 ]]; then
  printf '  - none\n'
else
  for path in "${required[@]}"; do
    bytes="$(wc -c < "$path" | tr -d ' ')"
    total_bytes=$((total_bytes + bytes))
    printf '  - %s (%s bytes)\n' "${path#"$workspace"/}" "$bytes"
  done
fi
printf 'required_context_bytes: %s\n' "$total_bytes"
if (( total_bytes > 12000 )); then
  printf 'context_warning: compact startup files before loading all of them\n'
else
  printf 'context_warning: none\n'
fi

printf 'conditional_context:\n'
for name in .ai/DECISIONS.md .ai/sessions docs README.md REPORT.md FINDINGS.md QUERY-RESPONSES.md behavior-catalog.yaml invariants.yaml SOURCES.md raw inputs .runtime; do
  if [[ -e "$target/$name" ]]; then
    printf '  - %s\n' "$relative/$name"
  fi
done
