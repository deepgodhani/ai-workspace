#!/usr/bin/env bash
# Compact, local-only token/cost summary across AI CLIs (Claude Code, Codex,
# Gemini, Kiro) via tokscale's JSON output. Read-only: never runs tokscale
# submit/autosubmit/login. Pinned version so numbers stay comparable over time.
set -euo pipefail

TOKSCALE_VERSION="${TOKSCALE_VERSION:-4.17.0}"
clients="claude,codex,gemini,kiro"
group="client,model"
args=()

usage() {
  cat >&2 <<'EOF'
Usage: bin/token-usage [--today|--week|--month|--since YYYY-MM-DD [--until YYYY-MM-DD]]
                       [--clients a,b] [--by-session] [--top N]

Default: last 7 days, all four CLIs, grouped by client+model.
--by-session   group per session (use for before/after comparison of one task)
--top N        rows to print (default 15)
EOF
  exit 2
}

top=15
period_set=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --today|--week|--month) args+=("$1"); period_set=1; shift ;;
    --since|--until) [[ $# -ge 2 ]] || usage; args+=("$1" "$2"); period_set=1; shift 2 ;;
    --clients) [[ $# -ge 2 ]] || usage; clients="$2"; shift 2 ;;
    --by-session) group="client,session,model"; shift ;;
    --top) [[ $# -ge 2 ]] || usage; top="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done
[[ $period_set -eq 1 ]] || args+=("--week")

command -v npx >/dev/null 2>&1 || { echo "npx not found (install Node.js)" >&2; exit 1; }

read -r -d '' summarize <<'PY' || true
import json, sys
top = int(sys.argv[1])
d = json.load(sys.stdin)
rows = d.get("entries", [])
def tot(e):
    return e["input"] + e["output"] + e["cacheRead"] + e["cacheWrite"]
rows.sort(key=lambda e: e.get("cost", 0), reverse=True)
print(f"{'client':<8} {'model':<22} {'session':<12} {'msgs':>6} {'tokens':>14} {'cache-read%':>11} {'out':>10} {'cost$':>9}")
for e in rows[:top]:
    t = tot(e)
    cr = (e["cacheRead"] / t * 100) if t else 0
    sess = str(e.get("sessionId") or e.get("session") or "")[:12]
    print(f"{e['client']:<8} {str(e['model'])[:22]:<22} {sess:<12} {e.get('messageCount',0):>6} {t:>14,} {cr:>10.1f}% {e['output']:>10,} {e.get('cost',0):>9.2f}")
T = d["totalInput"] + d["totalOutput"] + d["totalCacheRead"] + d["totalCacheWrite"]
crp = d["totalCacheRead"] / T * 100 if T else 0
print(f"\nTOTAL  rows={len(rows)}  messages={d.get('totalMessages',0):,}  tokens={T:,}  cache-read={crp:.1f}%  output={d['totalOutput']:,}  cost=${d.get('totalCost',0):.2f}")
print("cost = API-list-price estimate from local logs; subscription/credit billing differs.")
PY

json_out="$(npx -y "tokscale@${TOKSCALE_VERSION}" models --json -c "$clients" --group-by "$group" "${args[@]}")"
printf '%s' "$json_out" | python3 -c "$summarize" "$top"
