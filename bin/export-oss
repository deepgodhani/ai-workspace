#!/usr/bin/env python3
"""Export the reusable workspace framework into a clean, publishable repo.

Copies only paths listed in _shared/oss/manifest.txt, strips private blocks,
generates empty scaffolding, scans the result for secrets and personal data,
and syncs it into DEST only if the scan is clean. Never commits or pushes.

Usage: bin/export-oss [DEST] [--check] [--denylist FILE]
  DEST        default: projects/ai-workspace
  --check     build and scan only; do not touch DEST
  --denylist  extra words to block (default: <workspace>/.oss-denylist,
              one word or phrase per line, # comments allowed)
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

WS = Path(__file__).resolve().parent.parent
OSS = WS / "_shared" / "oss"

SKIP_NAMES = {".DS_Store", "__pycache__", ".pytest_cache", ".ruff_cache", ".venv", "node_modules", ".git"}
SKIP_SUFFIXES = (".pyc", ".bak", ".orig")
SKIP_PATHS = {
    "_shared/oss",
    "_shared/skills/workspace-coach/references/verification-agent-workflow.md",
    "tools/local-research/work",
    "tools/local-research/tests/output",
}
TEXT_SUFFIXES = {".md", ".sh", ".py", ".yml", ".yaml", ".json", ".toml", ".txt", ".js", ".ts", ""}

MD_BLOCK = re.compile(r"[ \t]*[ \t]*\n?", re.S)
HASH_BLOCK = re.compile(r"[ \t]*# private:begin\n.*?[ \t]*# private:end[ \t]*\n?", re.S)

SECRET_PATTERNS = {
    "anthropic/openai key": r"sk-(?:ant-)?[A-Za-z0-9_-]{20,}",
    "firecrawl key": r"\bfc-[A-Za-z0-9]{20,}",
    "aws access key": r"\bAKIA[0-9A-Z]{16}\b",
    "github token": r"\bgh[pousr]_[A-Za-z0-9]{30,}",
    "slack token": r"\bxox[abprs]-[A-Za-z0-9-]{10,}",
    "private key": r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "aws hostname": r"\b[a-z0-9.-]+\.compute(?:-1)?\.amazonaws\.com\b",
}
EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
EMAIL_OK = re.compile(r"@(?:example\.(?:com|org)|anthropic\.com|users\.noreply\.github\.com)$", re.I)


def skipped(rel: str) -> bool:
    parts = rel.split("/")
    if any(p in SKIP_NAMES for p in parts) or rel.endswith(SKIP_SUFFIXES):
        return True
    if any(rel == s or rel.startswith(s + "/") for s in SKIP_PATHS):
        return True
    if parts[0] == ".env" or parts[-1].startswith(".env") and parts[-1] != ".env.example":
        return True
    # agents/<agent>/cases/<case>: only the _template case is framework
    if len(parts) >= 4 and parts[0] == "agents" and parts[2] == "cases" and parts[3] != "_template":
        return True
    return False


def strip_private(rel: str, text: str) -> str:
    for marker, rx in (("<!-- private:", MD_BLOCK), ("# private:", HASH_BLOCK)):
        if marker in text:
            begins = text.count(marker + "begin")
            ends = text.count(marker + "end")
            if begins != ends:
                sys.exit(f"error: unbalanced private markers in {rel}")
            text = rx.sub("", text)
    return text


def copy_entry(rel: str, stage: Path) -> int:
    src = WS / rel
    if not src.exists() and not src.is_symlink():
        sys.exit(f"error: manifest path missing: {rel}")
    files = [src] if src.is_file() or src.is_symlink() else sorted(p for p in src.rglob("*") if p.is_file() or p.is_symlink())
    n = 0
    for f in files:
        r = f.relative_to(WS).as_posix()
        if skipped(r):
            continue
        dst = stage / r
        dst.parent.mkdir(parents=True, exist_ok=True)
        if f.is_symlink():
            os.symlink(os.readlink(f), dst)
        elif f.suffix in TEXT_SUFFIXES:
            try:
                text = f.read_text(encoding="utf-8")
            except UnicodeDecodeError:
                shutil.copy2(f, dst)
            else:
                dst.write_text(strip_private(r, text), encoding="utf-8")
                shutil.copymode(f, dst)
        else:
            shutil.copy2(f, dst)
        n += 1
    return n


def generate(stage: Path) -> None:
    put = lambda rel, src: (stage / rel).parent.mkdir(parents=True, exist_ok=True) or shutil.copy2(OSS / src, stage / rel)
    put("README.md", "README.md")
    put(".gitignore", "gitignore")
    put("LICENSE", "LICENSE")
    put("knowledge/README.md", "knowledge-README.md")
    put("projects/README.md", "projects-README.md")
    put("temp-sessions/README.md", "temp-sessions-README.md")
    for keep in ("research/topics", "worktrees", "knowledge/inbox", "knowledge/daily", "knowledge/indexes"):
        (stage / keep).mkdir(parents=True, exist_ok=True)
        (stage / keep / ".gitkeep").touch()
    (stage / "tools").mkdir(exist_ok=True)
    (stage / "tools" / "database-port-registry.yaml").write_text(
        "schema_version: '1.0'\n"
        "scope: local_database_endpoints\n"
        "policy:\n"
        "  bind_host: 127.0.0.1\n"
        "  notes:\n"
        "  - Entries record ownership and purpose, not whether a process is currently live.\n"
        "  - Do not reuse a port unless owner, case, role, and destination all match.\n"
        "  - Store no credentials or connection strings here.\n"
        "assignments: []\n",
        encoding="utf-8",
    )
    skills = stage / ".kiro" / "skills"
    skills.mkdir(parents=True, exist_ok=True)
    for s in sorted((stage / "_shared" / "skills").iterdir()):
        if (s / "SKILL.md").is_file():
            os.symlink(f"../../_shared/skills/{s.name}", skills / s.name)


def scan(stage: Path, deny: list[str]) -> list[str]:
    home = str(Path.home())
    rules = {k: re.compile(v) for k, v in SECRET_PATTERNS.items()}
    rules["home path"] = re.compile(re.escape(home) + r"\b")
    for w in deny:
        rules[f"denylist '{w}'"] = re.compile(r"(?<![A-Za-z0-9])" + re.escape(w) + r"(?![A-Za-z0-9])", re.I)
    hits = []
    for f in sorted(stage.rglob("*")):
        if f.is_symlink():
            target = os.readlink(f)
            inside = (f.parent / target).resolve().is_relative_to(stage.resolve())
            if os.path.isabs(target) or not inside:
                hits.append(f"{f.relative_to(stage).as_posix()}: symlink leaves the repo -> {target}")
            continue
        if not f.is_file():
            continue
        try:
            lines = f.read_text(encoding="utf-8").splitlines()
        except UnicodeDecodeError:
            continue
        rel = f.relative_to(stage).as_posix()
        for i, line in enumerate(lines, 1):
            for name, rx in rules.items():
                if rx.search(line):
                    hits.append(f"{rel}:{i}: {name}")
            for m in EMAIL.finditer(line):
                if not EMAIL_OK.search(m.group(0)):
                    hits.append(f"{rel}:{i}: email address")
    return hits


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("dest", nargs="?", default=str(WS / "projects" / "ai-workspace"))
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--denylist", default=str(WS / ".oss-denylist"))
    a = ap.parse_args()

    deny = []
    if Path(a.denylist).is_file():
        deny = [l.strip() for l in Path(a.denylist).read_text().splitlines() if l.strip() and not l.lstrip().startswith("#")]

    manifest = [l.strip() for l in (OSS / "manifest.txt").read_text().splitlines() if l.strip() and not l.startswith("#")]
    with tempfile.TemporaryDirectory() as tmp:
        stage = Path(tmp) / "stage"
        stage.mkdir()
        count = sum(copy_entry(rel, stage) for rel in manifest)
        generate(stage)
        hits = scan(stage, deny)
        size = sum(f.stat().st_size for f in stage.rglob("*") if f.is_file() and not f.is_symlink())
        print(f"staged {count} framework files (+ generated scaffolding), {size/1024:.0f} KiB; denylist terms: {len(deny)}")
        if hits:
            print(f"BLOCKED: {len(hits)} finding(s); nothing written:")
            for h in hits[:50]:
                print("  " + h)
            sys.exit(1)
        print("scan clean")
        if a.check:
            return
        dest = Path(a.dest).resolve()
        dest.mkdir(parents=True, exist_ok=True)
        subprocess.run(["rsync", "-a", "--delete", "--exclude", ".git", f"{stage}/", f"{dest}/"], check=True)
        if not (dest / ".git").exists():
            subprocess.run(["git", "-C", str(dest), "init", "-q"], check=True)
        changed = subprocess.run(["git", "-C", str(dest), "status", "--short"], capture_output=True, text=True).stdout.splitlines()
        print(f"exported to {dest}; {len(changed)} path(s) changed vs last commit (nothing committed)")


if __name__ == "__main__":
    main()
